rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // User Trials & 7-Day Subscriptions
    match /user_trials/{userId} {
      allow read, write: if true;
    }

    // Admin AI Engine Keys & Budgets
    match /admin_ai_keys/{keyId} {
      allow read, write: if true;
    }

    // Contact Inquiries (Enterprise & Support)
    match /contact_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Credentials Vault (BYOK & Subscriptions)
    match /credentials/{providerId} {
      allow read, write: if true;
    }

    // SMTP Settings (Admin Console)
    match /smtp_settings/{settingsId} {
      allow read, write: if true;
    }

    // Email Dispatch Logs
    match /email_logs/{logId} {
      allow read, write: if true;
    }

    // Dispatch Ledger & Task History
    match /dispatch_ledger/{ledgerId} {
      allow read, write: if true;
    }

    // Context Sessions (Persistence Toggle: Firestore vs Local Transient)
    match /context_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Admin Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Onboarded Companies
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Onboarded Teams & Access Control Policies
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // Email & Alert Notification Templates (HTML/Text)
    match /email_templates/{templateId} {
      allow read, write: if true;
    }
  }
}

